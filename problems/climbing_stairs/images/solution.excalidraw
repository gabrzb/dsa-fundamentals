      "isDeleted": false,
      "boundElements": null,
      "updated": 1794773883844,
      "link": null,
      "locked": false,
      "text": "Back at ways(4): memo[2] is a hit.\nSave memo[4] = 3 + 2 = 5.\nBack at ways(5): memo[3] is a hit.\nSave memo[5] = 5 + 3 = 8.",
