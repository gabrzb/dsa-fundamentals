      "link": null,
      "locked": false,
      "text": "ways(1) returns 1; ways(0) returns 1.\nSave memo[2] = 2; return to ways(3).\nUse base ways(1), save memo[3] = 3.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ways(1) returns 1; ways(0) returns 1.\nSave memo[2] = 2; return to ways(3).\nUse base ways(1), save memo[3] = 3.",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
