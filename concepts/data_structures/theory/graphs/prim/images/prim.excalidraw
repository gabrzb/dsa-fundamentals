      "isDeleted": false,
      "boundElements": null,
      "updated": 1794775747735,
      "link": null,
      "locked": false,
      "text": "Undirected edges: (0,1,4), (0,2,1), (2,1,2), (1,3,1), (2,3,5). Vertex 4 is isolated.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Undirected edges: (0,1,4), (0,2,1), (2,1,2), (1,3,1), (2,3,5). Vertex 4 is isolated.",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
