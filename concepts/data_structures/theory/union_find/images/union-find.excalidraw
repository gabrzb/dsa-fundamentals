    },
    {
      "id": "ICJhIQipErVfpejxY2xTE",
      "type": "text",
      "x": 18,
      "y": 495,
      "width": 409.7255859375,
      "height": 96.6,
      "angle": 0,
      "strokeColor": "#20324a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0N",
      "roundness": null,
      "seed": 612789080,
      "version": 2,
      "versionNonce": 2009581400,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794775747702,
      "link": null,
      "locked": false,
      "text": "Follow 7 -> 6 -> 4 -> 0 to find root 0.\nReturn along that path and set parents to 0.\nNodes 3 and 5 were not on the path.\nComponent count stays 2; root 0 has size 8.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Follow 7 -> 6 -> 4 -> 0 to find root 0.\nReturn along that path and set parents to 0.\nNodes 3 and 5 were not on the path.\nComponent count stays 2; root 0 has size 8.",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "tEEi2uf_V_G2YQ_1o1aWo",
      "type": "text",
      "x": 583,
      "y": 445,
      "width": 409.0810546875,
      "height": 26.45,
      "angle": 0,
      "strokeColor": "#20324a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 501913128,
      "version": 2,
      "versionNonce": 519895592,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794775747702,
      "link": null,
      "locked": false,
      "text": "union(8,0): smaller root becomes a child",
      "fontSize": 23,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "union(8,0): smaller root becomes a child",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "df2BQCIVFYqEvK3xPxxS5",
      "type": "text",
      "x": 583,
      "y": 495,
      "width": 412.09423828125,
      "height": 96.6,
      "angle": 0,
      "strokeColor": "#20324a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 2085568600,
      "version": 2,
      "versionNonce": 386210904,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794775747702,
      "link": null,
      "locked": false,
      "text": "Root 8 has size 1; root 0 has size 8.\nAttach 8 below 0, even though 8 was first.\nSet root size to 9 and component count to 1.\nRepeating union(8,0) returns false.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Root 8 has size 1; root 0 has size 8.\nAttach 8 below 0, even though 8 was first.\nSet root size to 9 and component count to 1.\nRepeating union(8,0) returns false.",
      "autoResize": true,
      "lineHeight": 1.15
