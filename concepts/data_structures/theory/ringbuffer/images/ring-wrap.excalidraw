      "text": "head is the next read; tail is the next write. Physical slots never shift.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "head is the next read; tail is the next write. Physical slots never shift.",
      "autoResize": true,
      "lineHeight": 1.15
    },
