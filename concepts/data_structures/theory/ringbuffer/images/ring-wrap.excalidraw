      "updated": 1794770697953,
      "link": null,
      "locked": false,
      "text": "Full and empty can share head = tail = 1. Compare size with capacity to distinguish them.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Full and empty can share head = tail = 1. Compare size with capacity to distinguish them.",
