      "boundElements": null,
      "updated": 1794770698056,
      "link": null,
      "locked": false,
      "text": "prefix[0] = 0. After step i, prefix[i + 1] includes values[0] through values[i].",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "prefix[0] = 0. After step i, prefix[i + 1] includes values[0] through values[i].",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
