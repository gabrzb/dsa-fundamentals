      "isDeleted": false,
      "boundElements": null,
      "updated": 1794770696452,
      "link": null,
      "locked": false,
      "text": "Root: remaining = 2, last = 4 - 2 + 1 = 3. Do not choose 4.",
      "fontSize": 21,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Root: remaining = 2, last = 4 - 2 + 1 = 3. Do not choose 4.",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "concept-510",
      "type": "text",
      "x": 20,
      "y": 950,
      "width": 640.01611328125,
      "height": 21.849999999999998,
      "angle": 0,
      "strokeColor": "#1e293b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.4,
      "strokeStyle": "solid",
      "roughness": 0.5,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 1056503351,
      "version": 2,
      "versionNonce": 255254423,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794770696452,
      "link": null,
      "locked": false,
      "text": "Starting with [4] would leave zero later candidates for the one missing value.",
      "fontSize": 19,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Starting with [4] would leave zero later candidates for the one missing value.",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
